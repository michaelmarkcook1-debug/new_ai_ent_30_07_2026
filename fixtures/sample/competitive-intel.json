  "categories": {
    "model_capability": {
      "id": "model_capability",
      "label": "Model Capability",
      "description": "Evaluates the depth and cadence of each vendor's frontier model portfolio.",
      "methodology": {
        "summary": "Scored across frontier reasoning, multimodal coverage, coding performance, long-context handling and model release cadence.",
        "details": "Each dimension carries an illustrative intensity from 0 to 5, where 3 represents the peer median and 5 the top of the tracked set. Dimensions are averaged into the category score. All values on this page are samples authored for the demo."
      }
    },
    "enterprise_traction": {
      "id": "enterprise_traction",
      "label": "Enterprise Traction",
      "description": "Captures how deeply each vendor is embedded in enterprise production estates.",
      "methodology": {
        "summary": "Rolls up deployment depth, regulated-industry presence, admin and audit controls, procurement reach and partner delivery network.",
        "details": "Each dimension carries an illustrative intensity from 0 to 5 normalised across the peer set. Dimensions are averaged into the category score. All values on this page are samples authored for the demo."
      }
    },
    "ecosystem_leverage": {
      "id": "ecosystem_leverage",
      "label": "Ecosystem Leverage",
      "description": "Measures distribution strength through clouds, developers and data platforms.",
      "methodology": {
        "summary": "Tracks cloud distribution breadth, developer mindshare, agent tooling surface and data platform integrations.",
        "details": "Each dimension carries an illustrative intensity from 0 to 5 normalised across the peer set. Dimensions are averaged into the category score. All values on this page are samples authored for the demo."
      }
    }
  },
  "metricDescriptions": {
    "Frontier Reasoning": "Relative strength of the vendor's best reasoning models against the tracked peer set.",
    "Multimodal Coverage": "Breadth of text, image, audio and video capability across the shipping model line.",
    "Coding Performance": "Strength of the vendor's models on software engineering workloads and coding assistants.",
    "Long-context Handling": "How well model quality holds up at long context lengths.",
    "Model Release Cadence": "Pace of material model releases and refreshes over the trailing year.",
    "Enterprise Deployment Depth": "How far deployments typically progress beyond pilots into production estates.",
    "Regulated-industry Presence": "Observed footprint in financial services, healthcare, public sector and other regulated buyers.",
    "Admin and Audit Controls": "Maturity of tenant controls, audit logging, retention and policy tooling.",
    "Procurement Reach": "Ease of buying through existing enterprise agreements and marketplaces.",
    "Partner Delivery Network": "Scale of the services and integrator channel that delivers the vendor's stack.",
    "Cloud Distribution Breadth": "Availability of the vendor's models and tooling across the major clouds.",
    "Developer Mindshare": "Share of developer attention signalled by tooling defaults and community activity.",
    "Agent Tooling Surface": "Extent of shipped agent primitives such as tool use, computer use and orchestration.",
    "Data Platform Integrations": "Depth of integration with enterprise data platforms and warehouses."
  }
}
