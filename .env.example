# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# BoardRadar API (server-side only; the key never reaches the browser)
ANALYSTGENIUS_API_BASE=
ANALYSTGENIUS_API_KEY=

# Set to true to serve recorded fixtures instead of live API calls
MOCK_MODE=false

# Local read-only checkout of the ranking-engine repository (AIE dataset source)
RANKING_ENGINE_REPO_PATH=../ranking-engine

# Anthropic API key for the AI Analyst; leave empty for scripted sample mode
ANTHROPIC_API_KEY=

# Basic auth for the demo shell
DEMO_USER=
DEMO_PASS=
